{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flash2Mart Web (Web Server Mode)",
      "request": "launch",
      "type": "dart",
      "deviceId": "web-server",
      "args": [
        "--web-port", "8080"
      ]
    },
    {
      "name": "Flash2Mart Web (Chrome Direct)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--web-browser-flag", "--no-sandbox",
        "--web-browser-flag", "--disable-gpu"
      ]
    }
  ]
}